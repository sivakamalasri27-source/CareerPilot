# ==============================================================================
# CareerPilot Backend Environment Variables Template
# Copy this file to .env or configure in your deployment platform (Railway/Render).
# ==============================================================================

# Server Profile & Port
SERVER_PORT=8080
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL)
# Either provide host/port/name/user/pass OR full SPRING_DATASOURCE_URL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=careerpilot
DB_USER=careerpilot_user
DB_PASSWORD=careerpilot_secret
DB_MAX_POOL_SIZE=10
# SPRING_DATASOURCE_URL=postgresql://careerpilot_user:careerpilot_secret@localhost:5432/careerpilot

# Security & Authentication (JWT HMAC-SHA256)
# Minimum 256 bits (32 chars) - generate a secure random string for production
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000
REFRESH_TOKEN_EXPIRATION_MS=604800000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Provider Configuration (Google Gemini)
# Provider: 'gemini' for Google Gemini, or 'fake' for offline mock testing
LLM_PROVIDER=gemini

# Gemini API Key: Set either GEMINI_API_KEY or LLM_API_KEY (must start with AIza...)
# Obtain a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Alternatively:
# LLM_API_KEY=AIzaSyYourRealKeyHere

# Gemini Model name (defaults to gemini-2.5-flash if unset)
LLM_MODEL=gemini-2.5-flash

# GitHub API Token (Optional, boosts unauthenticated limit from 60 to 5000 req/hr)
GITHUB_TOKEN=

# API Rate Limiter (Token bucket per authenticated user)
RATE_LIMIT_CAPACITY=30
RATE_LIMIT_REFILL_TOKENS=30
RATE_LIMIT_REFILL_DURATION_SECONDS=60

# Swagger / OpenAPI Documentation (Disable in strict production if desired)
SWAGGER_ENABLED=true
