# ==============================================================================
# CareerPilot Environment Variables Template
# Copy this file to .env and replace placeholder values with real configurations.
# NEVER commit the .env file with actual credentials to version control.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=careerpilot
DB_USER=careerpilot_user
DB_PASSWORD=careerpilot_secret
DB_MAX_POOL_SIZE=10

# Security & JWT Configuration
# Base64 encoded or plaintext secret key (minimum 256 bits / 32 characters)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000
REFRESH_TOKEN_EXPIRATION_MS=604800000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Provider Configuration (openai | gemini | anthropic)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# GitHub API Integration (optional, increases public API rate limits from 60 to 5000 req/hr)
GITHUB_API_TOKEN=

# Rate Limiting (Token Bucket per user)
RATE_LIMIT_CAPACITY=30
RATE_LIMIT_REFILL_TOKENS=30
RATE_LIMIT_REFILL_DURATION_SECONDS=60
