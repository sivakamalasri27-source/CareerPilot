# ==============================================================================
# CareerPilot Root Environment Variables Template
# Copy this file to .env before running `docker-compose up --build`.
# NEVER commit .env with real production secrets to version control.
# ==============================================================================

# Application Ports
BACKEND_PORT=8080
FRONTEND_PORT=3000
DB_PORT=5432

# Spring Profiles (dev, prod, test)
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL Database Configuration
DB_NAME=careerpilot
DB_USER=careerpilot_user
DB_PASSWORD=careerpilot_secret
DB_HOST=postgres
DB_MAX_POOL_SIZE=20
# Optional full JDBC URL (useful for cloud managed DBs like Railway/Supabase/RDS)
# SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/careerpilot

# Security & Authentication (JWT Secret - minimum 256 bits / 32 characters)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000
REFRESH_TOKEN_EXPIRATION_MS=604800000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# AI Provider Configuration (Google Gemini)
# Provider: 'gemini' for Google Gemini, or 'fake' for offline mock testing
LLM_PROVIDER=gemini

# Gemini API Key: Set either GEMINI_API_KEY or LLM_API_KEY (must start with AIza...)
# Obtain a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Alternatively:
# LLM_API_KEY=AIzaSyYourRealKeyHere

# Gemini Model name (defaults to gemini-2.5-flash if unset)
LLM_MODEL=gemini-2.5-flash

# GitHub API Integration (Optional: public repos only, token boosts rate limits)
GITHUB_TOKEN=

# Token Bucket Rate Limiting (per user)
RATE_LIMIT_CAPACITY=30
RATE_LIMIT_REFILL_TOKENS=30
RATE_LIMIT_REFILL_DURATION_SECONDS=60

# Swagger / OpenAPI Documentation
SWAGGER_ENABLED=true

# Frontend Configuration
VITE_API_URL=http://localhost:8080
